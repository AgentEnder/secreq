# Rust build output
/target

# The woff2 cuts + licences built by `nx build secreq-webfonts`. Not committed:
# the output is a pure function of a pinned crate, so a stored copy could only
# ever fall behind it. `docs-site/vite.config.ts` mirrors this into the site's
# `public/fonts` at build time.
/packages/webfonts/dist

# Node dependencies (SDK + examples) and the Nx monorepo scaffold
node_modules/
.nx/
*.tsbuildinfo

# Logs and scratch output
*.log

# Release tarballs from scripts/package-release.sh. NOT /dist wholesale —
# dist/install.sh and dist/homebrew/ are tracked.
/dist/*.tar.gz

# Scratch renders from exercise-only screenshot fixtures (see
# tests/ui_screenshots.rs::SCRATCH_DIR) — never published, never committed.
/tmp/

# Agent worktrees: full checkouts of this repo living inside it. Every tool
# that walks the tree finds a second copy of every file — Nx sees duplicate
# projects, formatters and linters check stale code and report errors against
# a file nobody is editing. Scratch space, never a build input.
.claude/worktrees/
