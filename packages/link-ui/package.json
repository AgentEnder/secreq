{
  "name": "@secreq/link-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/sync-crate-assets.mjs",
    "dev": "vite",
    "format": "oxfmt . '!dist/**'",
    "format:check": "oxfmt --check . '!dist/**'",
    "lint": "oxlint src scripts",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.10"
  }
}
