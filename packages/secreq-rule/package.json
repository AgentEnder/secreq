{
  "name": "secreq-rule",
  "version": "0.1.0",
  "description": "AssemblyScript helper for authoring secreq programmable auto-rules: RuleCtx / Decision types plus the linear-memory ABI glue and a build wrapper around asc.",
  "keywords": [
    "assemblyscript",
    "auto-rules",
    "consent",
    "policy",
    "secreq",
    "security",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "bin": {
    "secreq-rule-build": "bin/build.js"
  },
  "files": [
    "assembly/",
    "bin/",
    "testing/assembly.ts",
    "testing/index.js",
    "index.ts",
    "asconfig.json"
  ],
  "types": "assembly/index.ts",
  "exports": {
    ".": "./index.ts",
    "./assembly/*": "./assembly/*",
    "./testing": "./testing/index.js",
    "./testing/assembly": "./testing/assembly.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "ascMain": "assembly/index.ts"
}
