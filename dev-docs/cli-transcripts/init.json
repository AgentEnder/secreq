            "t": "│"
          }
        ],
        [
          {
            "f": "2",
            "t": "◇"
          },
          {
            "t": "  Add secreq to your PATH "
          },
          {
            "f": "8",
            "t": "──────────────────────────────────────────────╮"
          }
        ],
