        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  "
          },
          {
            "s": 2,
            "t": "~/.secreq/shims isn't on PATH. I can append this to ~/.zshrc (Zsh):"
          },
          {
            "t": "   "
          },
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "                                                                        "
          },
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  "
          },
          {
            "s": 2,
            "t": "# >>> secreq managed PATH (do not edit by hand) >>>"
          },
          {
            "t": "                   "
          },
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  "
          },
          {
            "s": 2,
            "t": "export PATH=\"$HOME/.secreq/shims:$PATH\""
          },
          {
            "t": "                               "
          },
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  "
          },
          {
            "s": 2,
            "t": "# <<< secreq managed PATH <<<"
          },
          {
            "t": "                                         "
          },
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "8",
            "t": "├────────────────────────────────────────────────────────────────────────╯"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "3",
            "t": "▲"
          },
          {
            "t": "  zsh note: writing to .zshrc (which runs after .zprofile, where homebrew"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  lives) so our prepend wins on PATH. Non-interactive zsh launched externally"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  (ssh non-login, cron) doesn't read .zshrc — children of your interactive"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  shell inherit PATH from it though, so npm postinstalls and the like still"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          },
          {
            "t": "  see the shim."
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "6",
            "t": "◆"
