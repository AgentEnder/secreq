{
  "caption": "First-time setup. Installing secreq changes nothing on your <code>PATH</code> — <code>init</code> shows you the exact block it wants to add and the exact file it would go in, then waits for an answer.",
  "cols": 80,
  "command": "secreq init",
  "id": "init",
  "steps": [
    {
      "kind": "frame",
      "lines": [
        [
          {
            "f": "8",
            "t": "┌"
          },
          {
            "t": "  secreq init — first-time setup"
          }
        ],
        [
          {
            "f": "8",
            "t": "│"
          }
        ],
        [
          {
            "f": "6",
            "t": "◆"
          },
          {
            "t": "  Where should secreq drop PATH shims?"
          }
        ],
        [
          {
            "f": "6",
            "t": "│"
          },
          {
            "t": "  "
          },
          {
            "s": 16,
            "t": "~"
          },
          {
            "s": 2,
            "t": "/.secreq/shims"
          }
        ],
        [
          {
            "f": "6",
            "t": "└"
          }
        ]
      ]
    },
    {
      "key": "Enter",
      "kind": "key"
    },
    {
      "kind": "frame",
      "lines": [
        [
          {
