{
  "name": "@secreq/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vike dev",
    "build": "vike build && pnpm exec pagefind --site dist/client",
    "preview": "vike build && pnpm exec pagefind --site dist/client && vike preview"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.21.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-github-alerts": "^4.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "unified": "^11.0.5",
    "vike": "^0.4.256",
    "vike-react": "^0.6.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "pagefind": "^1.4.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  },
  "nx": {
    "name": "docs-site",
    "targets": {
      "build": {
        "outputs": ["{projectRoot}/dist"]
      },
      "deploy": {
        "dependsOn": ["build"],
        "executor": "nx-github-pages:deploy",
        "options": {
          "remote": "https://github.com/AgentEnder/secreq.git",
          "directory": "{projectRoot}/dist/client",
          "CNAME": "secreq.dev"
        }
      }
    }
  }
}
