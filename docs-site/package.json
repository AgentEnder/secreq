{
  "name": "@secreq/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "typedoc --options typedoc.json && vike dev",
    "extract-docs": "typedoc --options typedoc.json",
    "typecheck-docs": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/typecheck-docs.mts",
    "build": "typedoc --options typedoc.json && vike build && pnpm exec pagefind --site dist/client",
    "preview": "typedoc --options typedoc.json && vike build && pnpm exec pagefind --site dist/client && vike preview"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.21.0",
    "gray-matter": "^4.0.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rehype-github-alerts": "^4.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-typedoc": "^0.2.0",
    "remark-directive": "^3.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^3.21.0",
    "typedoc": "^0.28.18",
    "unified": "^11.0.5",
    "vike": "^0.4.256",
    "vike-plugin-typedoc": "^0.2.0",
    "vike-react": "^0.6.21"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "pagefind": "^1.4.0",
    "secreq-rule": "workspace:*",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.2",
    "vite": "^7.3.1"
  },
  "nx": {
    "name": "docs-site",
    "implicitDependencies": [
      "docs",
      "dev-docs",
      "secreq-webfonts"
    ],
    "targets": {
      "lint": {
        "command": "oxlint docs-site",
        "inputs": [
          "js"
        ],
        "cache": true,
        "outputs": []
      },
      "format:check": {
        "command": "oxfmt --check docs-site",
        "inputs": [
          "js"
        ],
        "cache": true,
        "outputs": []
      },
      "format": {
        "command": "oxfmt docs-site",
        "cache": false
      },
      "build": {
        "dependsOn": [
          "^build"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "inputs": [
          "js",
          "^js",
          "{workspaceRoot}/docs/**/*",
          "{workspaceRoot}/dev-docs/**/*",
          "{workspaceRoot}/dist/install.sh",
          {
            "env": "BASE_URL"
          }
        ]
      },
      "typecheck-docs": {
        "cache": true,
        "inputs": [
          "{projectRoot}/scripts/typecheck-docs.mts",
          "{workspaceRoot}/docs/wasm-rules.md",
          "{workspaceRoot}/packages/secreq-rule/README.md",
          "{workspaceRoot}/packages/secreq-rule/index.ts",
          "{workspaceRoot}/packages/secreq-rule/assembly/**/*.ts",
          "{workspaceRoot}/packages/secreq-rule/testing/assembly.ts"
        ],
        "outputs": []
      },
      "dev": {
        "dependsOn": [
          "^build"
        ]
      },
      "preview": {
        "dependsOn": [
          "^build"
        ]
      },
      "deploy": {
        "dependsOn": [
          "build"
        ],
        "executor": "nx-github-pages:deploy",
        "options": {
          "remote": "https://github.com/AgentEnder/secreq.git",
          "directory": "{projectRoot}/dist/client"
        }
      }
    }
  }
}
