{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/mise.toml"],
    "rust": [
      "default",
      "{workspaceRoot}/Cargo.toml",
      "{workspaceRoot}/Cargo.lock",
      "{workspaceRoot}/clippy.toml"
    ],
    "js": [
      "default",
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/.oxfmtrc.json"
    ],
    "prose": ["default", "{workspaceRoot}/.vale.ini", "{workspaceRoot}/.vale/styles/**/*"],
    "rootSources": [
      "sharedGlobals",
      "{workspaceRoot}/**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,json,jsonc,css,md,yml,yaml}",
      "!{workspaceRoot}/docs-site/**/*",
      "!{workspaceRoot}/packages/**/*",
      "!{workspaceRoot}/docs/**/*",
      "!{workspaceRoot}/dev-docs/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "check": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "cache": true,
      "outputs": []
    },
    "lint": {
      "cache": true,
      "outputs": []
    },
    "format:check": {
      "cache": true,
      "outputs": []
    }
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    "@monodon/rust"
  ],
  "release": {
    "projects": ["secreq-rule"]
  },
  "analytics": true
}
